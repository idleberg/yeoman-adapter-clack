{
	"name": "yeoman-adapter-clack",
	"version": "0.4.0",
	"description": "A Yeoman adapter that replaces Inquirer with Clack as the default prompt library",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/yeoman-adapter-clack.git"
	},
	"keywords": [
		"yeoman-adapter",
		"clack",
		"prompts",
		"yeoman"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"engines": {
		"node": "^20.17.0 || >=22.9.0"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "#vitest run"
	},
	"dependencies": {
		"@yeoman/adapter": "^4.0.2",
		"yeoman-generator": "^8.2.2"
	},
	"devDependencies": {
		"@clack/prompts": "^1.4.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@idleberg/configs": "^0.4.2",
		"@types/node": "^24.12.0",
		"@vitest/coverage-v8": "^4.1.6",
		"concurrently": "^9.2.1",
		"np": "^11.2.1",
		"tsdown": "^0.22.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6",
		"yeoman-environment": "^6.1.0"
	},
	"peerDependencies": {
		"@clack/prompts": "^1.4.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		],
		"overrides": {
			"tmp@<=0.2.3": ">=0.2.4",
			"lodash-es@>=4.0.0 <=4.17.22": ">=4.17.23",
			"minimatch@<10.2.1": ">=10.2.1",
			"tar@<7.5.8": ">=7.5.8"
		}
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
