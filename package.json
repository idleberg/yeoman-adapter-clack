{
	"name": "yeoman-adapter-clack",
	"version": "0.5.0",
	"description": "A Yeoman adapter that replaces Inquirer with Clack as the default prompt library",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/yeoman-adapter-clack.git"
	},
	"keywords": [
		"yeoman-adapter",
		"clack",
		"prompts",
		"yeoman"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"engines": {
		"node": "^20.17.0 || >=22.9.0"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "vitest run"
	},
	"dependencies": {
		"@yeoman/adapter": "^5.0.0",
		"yeoman-generator": "^8.3.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@idleberg/configs": "^0.4.6",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "^5.0.0",
		"concurrently": "^10.0.5",
		"np": "^12.1.0",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0",
		"yeoman-environment": "^6.3.0"
	},
	"peerDependencies": {
		"@clack/prompts": "^1.7.0"
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
