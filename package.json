{
	"name": "yeoman-adapter-clack",
	"version": "0.4.1",
	"description": "A Yeoman adapter that replaces Inquirer with Clack as the default prompt library",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/yeoman-adapter-clack.git"
	},
	"keywords": [
		"yeoman-adapter",
		"clack",
		"prompts",
		"yeoman"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"engines": {
		"node": "^20.17.0 || >=22.9.0"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "#vitest run"
	},
	"dependencies": {
		"@yeoman/adapter": "^4.0.2",
		"yeoman-generator": "^8.2.2"
	},
	"devDependencies": {
		"@clack/prompts": "^1.4.0",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@idleberg/configs": "^0.4.2",
		"@types/node": "^24.12.0",
		"@vitest/coverage-v8": "^4.1.6",
		"concurrently": "^9.2.1",
		"np": "^11.2.1",
		"tsdown": "^0.22.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6",
		"yeoman-environment": "^6.1.0"
	},
	"peerDependencies": {
		"@clack/prompts": "^1.4.0"
	},
	"packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
